# Copy to `.env` and fill in values. Never commit `.env`.

# Required: your honeypot / admin API base URL (no trailing slash)
VITE_BACKEND_URL=https://your-api.example.com

# Optional third-party keys (features degrade gracefully when unset)
VITE_IPDATA_API_KEY=
VITE_RANSOMWARE_LIVE_API_KEY=
VITE_GEMINI_API_KEY=
